# Puerto HTTP del servidor
SERVER_PORT=3000
# URL pública del cliente para CORS
CLIENT_ORIGIN=http://localhost:5173
# Configuración para PostgreSQL/PostGIS
POSTGRES_DB=bananapp
POSTGRES_USER=bananapp
POSTGRES_PASSWORD=bananapp_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bananapp:bananapp_dev_only@localhost:5432/bananapp
# Configuración de clima para fases posteriores
CLIMA_CACHE_TTL_MIN=45
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
